#!/usr/bin/env bash

# file: install
# author: Josue Teodoro Moreira <teodoro.josue@protonmail.ch>
#
# Ubuntu: install the i3 desktop and symlink these dotfiles into ~/.config.
# Existing files are moved aside to <file>.bak.<timestamp>, never deleted.
#
#   ./install          packages, fonts and links
#   ./install links    links only (no sudo)

set -euo pipefail

dotfiles=$(cd "$(dirname "$0")" && pwd)
stamp=$(date +%Y%m%d%H%M%S)

packages=(
  # x server (ubuntu 26.04 ships wayland only) + i3
  xserver-xorg-core xserver-xorg-input-libinput xinit x11-xserver-utils x11-xkb-utils xinput
  i3 i3lock xss-lock

  # bar, launcher, compositor, notifications, wallpaper
  polybar rofi picom dunst libnotify-bin feh

  # screenshots, clipboard, lock screen blur
  maim xclip xdotool imagemagick

  # hardware keys and audio
  brightnessctl playerctl pulseaudio-utils pavucontrol

  # network, bluetooth, displays, night light, auth prompts
  network-manager-gnome blueman arandr autorandr redshift policykit-1-gnome

  # looks
  papirus-icon-theme fonts-noto-color-emoji lxappearance

  curl unzip
)

install_packages() {
  echo '==> apt packages'
  sudo apt-get update
  sudo apt-get install -y "${packages[@]}"

  echo '==> touchpad tap-to-click under X'
  sudo mkdir -p /etc/X11/xorg.conf.d
  sudo cp "$dotfiles/xorg/30-touchpad.conf" /etc/X11/xorg.conf.d/
}

install_fonts() {
  if fc-list | grep -qi 'Mononoki Nerd Font'; then
    echo '==> Mononoki Nerd Font already installed'
    return
  fi
  echo '==> Mononoki Nerd Font'
  local tmp
  tmp=$(mktemp -d)
  curl -fsSLo "$tmp/Mononoki.zip" https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Mononoki.zip
  mkdir -p ~/.local/share/fonts/MononokiNerd
  unzip -oq "$tmp/Mononoki.zip" -d ~/.local/share/fonts/MononokiNerd '*.ttf'
  rm -rf "$tmp"
  fc-cache -f ~/.local/share/fonts
}

# link <path in repo> <target>
link() {
  local src=$dotfiles/$1 dst=$2
  mkdir -p "$(dirname "$dst")"
  if [[ -L $dst ]]; then
    rm "$dst"
  elif [[ -e $dst ]]; then
    mv "$dst" "$dst.bak.$stamp"
    echo "    moved old $dst to $dst.bak.$stamp"
  fi
  ln -s "$src" "$dst"
  echo "    $dst -> $src"
}

install_links() {
  echo '==> links'
  link i3/config ~/.config/i3/config
  link i3/scripts ~/.config/i3/scripts
  link polybar ~/.config/polybar
  link rofi/config.rasi ~/.config/rofi/config.rasi
  link picom/picom.conf ~/.config/picom/picom.conf
  link dunst/dunstrc ~/.config/dunst/dunstrc
  link alacritty/alacritty.toml ~/.config/alacritty/alacritty.toml
  link gtk/settings.ini ~/.config/gtk-3.0/settings.ini
}

case ${1:-all} in
  links) install_links ;;
  all)
    install_packages
    install_fonts
    install_links
    cat <<'EOF'

==> done. Log out, click your name at the login screen, pick "i3" from the
    gear in the bottom-right corner, then log in.
EOF
    ;;
  *) echo "usage: $0 [links]" >&2; exit 2 ;;
esac
