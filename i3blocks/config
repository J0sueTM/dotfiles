# ~/.config/i3blocks/config
# Josue Teodoro Moreira <teodoro.josue@protonmail.ch>
# September 12, 2021

separator=true
separator_block_width=20

[cpu]
label=cpu: 
command=iostat -c | sed '4q;d' | awk '{ print 100 - $6 "%" }'
interval=5

[memory]
label=mem: 
command=free -mh --si | awk '/^Mem:/ { print $3 "/" $2 }'
interval=5

[date]
label=date: 
command=date '+%d-%m-%Y %H:%M:%S'
interval=1
