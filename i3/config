# ~/.config/i3/config
# Josue Teodoro Moreira <teodoro.josue@protonmail.ch>
#
# palette "forest night" (shared with polybar, rofi, dunst, alacritty)
#   bg #0b0e0d  surface #141918  border #2a3331  muted #6f7d78  fg #dfe3dc
#   gold #e6b450  teal #5fb3a1  red #e5675f

set $mod Mod4
set $scripts ~/.config/i3/scripts

# Titles are never drawn: windows have pixel borders, and the tab row of
# tabbed/stacked containers is made invisible by picom, with the tabs shown in
# polybar instead (scripts/tabs.sh). A 1pt font shrinks that row to an 8px gap.
font pango:Mononoki Nerd Font 1

# ------------------------------------------------------------------ colors

set $bg      #0b0e0d
set $surface #141918
set $raised  #1f2726
set $border  #2a3331
set $muted   #6f7d78
set $fg      #dfe3dc
set $gold    #e6b450
set $teal    #5fb3a1
set $red     #e5675f

# class                   border    bg        text      indicator child_border
client.focused            $raised   $raised   $gold     $teal     $gold
client.focused_tab_title  $surface  $surface  $fg
client.focused_inactive   $surface  $surface  $fg       $border   $border
client.unfocused          $bg       $bg       $muted    $border   $border
client.urgent             $red      $red      $bg       $red      $red
client.placeholder        $bg       $bg       $muted    $bg       $bg
client.background         $bg

# --------------------------------------------------------------- appearance

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none

gaps inner 10
gaps outer 0


# floating by nature
for_window [window_role="pop-up"]        floating enable
for_window [window_role="dialog"]        floating enable
for_window [window_type="dialog"]        floating enable
for_window [class="Pavucontrol"]         floating enable, resize set 720 480, move position center
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Blueman-manager"]     floating enable, resize set 640 420, move position center
for_window [class="Arandr"]              floating enable

# ------------------------------------------------------------------ startup

# keyboard layout (ibus comes from the gnome session and resets it, and its
# tray icon is useless here)
exec --no-startup-id sh -c 'ibus exit; setxkbmap us dvp'

# monitors, then wallpaper and bar (re-run on restart, mod+Shift+r, after hotplug)
exec_always --no-startup-id $scripts/monitors.sh

# natural scrolling + tap-to-click, like gnome
exec_always --no-startup-id $scripts/input.sh

# same top gap for tabbed/stacked layouts as for plain windows
exec_always --no-startup-id $scripts/tabgap.sh

# compositor: rounded corners, shadows, fades
exec_always --no-startup-id sh -c 'pkill -x picom; sleep 0.3; exec picom'

# notifications
exec_always --no-startup-id sh -c 'pkill -x dunst; sleep 0.3; exec dunst'

# lock on suspend / idle
exec --no-startup-id xss-lock --transfer-sleep-lock -- $scripts/lock.sh

# tray applets and session helpers (wifi lives in the bar: scripts/wifi.sh)
exec --no-startup-id blueman-applet
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1
exec --no-startup-id gnome-keyring-daemon --start --components=secrets,ssh

# blue light filter (São Paulo)
exec --no-startup-id redshift -l -23.5:-46.6 -t 6500:4500 -b 1.0:0.9

# charger: performance + 120Hz, battery: balanced + 60Hz
exec_always --no-startup-id $scripts/power.sh

# ------------------------------------------------------------------ keybinds

# h t n s (dvorak)
set $left h
set $down t
set $up n
set $right s

floating_modifier $mod
tiling_drag modifier titlebar

# apps
bindsym $mod+Return exec alacritty
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+w exec --no-startup-id rofi -show window
bindsym $mod+Escape exec --no-startup-id $scripts/powermenu.sh
bindsym $mod+Ctrl+l exec --no-startup-id loginctl lock-session

# screenshots: region -> clipboard (+ a copy in /tmp), Print -> full screen
bindsym $mod+Shift+d exec --no-startup-id $scripts/screenshot.sh region
bindsym Print exec --no-startup-id $scripts/screenshot.sh full

# kill window
bindsym $mod+c kill

# focus with h t n s
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

# move with h t n s
bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right

# move workspace between monitors
bindsym $mod+Ctrl+$left  move workspace to output left
bindsym $mod+Ctrl+$right move workspace to output right
bindsym $mod+Ctrl+$up    move workspace to output up
bindsym $mod+Ctrl+$down  move workspace to output down

# split
bindsym $mod+g split h
bindsym $mod+l split v

# fullscreen
bindsym $mod+f fullscreen toggle

# layout
# stacked looks like tabbed now (tabs live in the bar) but i3 reserves 8px
# per window above it, so stacking is just tabbed
bindsym $mod+Ctrl+Shift+s layout tabbed
bindsym $mod+Ctrl+Shift+t layout tabbed
bindsym $mod+Ctrl+Shift+l layout toggle split

# floating
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle

# focus parent
bindsym $mod+a focus parent

# scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# toggle gaps
bindsym $mod+Shift+g gaps inner current toggle 10

# workspaces
set $ws1 "1:α"
set $ws2 "2:β"
set $ws3 "3:γ"
set $ws4 "4:δ"
set $ws5 "5:ε"

bindsym $mod+equal        workspace $ws1
bindsym $mod+asterisk     workspace $ws2
bindsym $mod+parenright   workspace $ws3
bindsym $mod+plus         workspace $ws4
bindsym $mod+bracketright workspace $ws5

bindsym $mod+Shift+9 move container to workspace $ws1
bindsym $mod+Shift+0 move container to workspace $ws2
bindsym $mod+Shift+2 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+6 move container to workspace $ws5

# keyboard layout
bindsym $mod+Shift+u exec --no-startup-id $scripts/kbd.sh set us dvp
bindsym $mod+Shift+e exec --no-startup-id $scripts/kbd.sh set br dvorak
bindsym $mod+Shift+o exec --no-startup-id $scripts/kbd.sh set br

# media keys
bindsym XF86AudioRaiseVolume  exec --no-startup-id wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume  exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute         exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute      exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86AudioPlay         exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext         exec --no-startup-id playerctl next
bindsym XF86AudioPrev         exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# reload / restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# resize
mode "resize" {
  bindsym $left  resize shrink width 10 px or 10 ppt
  bindsym $down  resize grow height 10 px or 10 ppt
  bindsym $up    resize shrink height 10 px or 10 ppt
  bindsym $right resize grow width 10 px or 10 ppt

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# mouse
mode "mouse" {
  set $slow 1
  set $quick 10
  set $fast 50

  bindsym $left  exec xdotool mousemove_relative -- -$fast 0
  bindsym $down  exec xdotool mousemove_relative 0 $fast
  bindsym $up    exec xdotool mousemove_relative -- 0 -$fast
  bindsym $right exec xdotool mousemove_relative $fast 0

  bindsym Ctrl+$left  exec xdotool mousemove_relative -- -$quick 0
  bindsym Ctrl+$down  exec xdotool mousemove_relative 0 $quick
  bindsym Ctrl+$up    exec xdotool mousemove_relative -- 0 -$quick
  bindsym Ctrl+$right exec xdotool mousemove_relative $quick 0

  bindsym $mod+Ctrl+$left  exec xdotool mousemove_relative -- -$slow 0
  bindsym $mod+Ctrl+$down  exec xdotool mousemove_relative 0 $slow
  bindsym $mod+Ctrl+$up    exec xdotool mousemove_relative -- 0 -$slow
  bindsym $mod+Ctrl+$right exec xdotool mousemove_relative $slow 0

  bindsym a exec xdotool click 1
  bindsym o exec xdotool click 2
  bindsym e exec xdotool click 3

  bindsym Ctrl+a exec xdotool mousedown 1
  bindsym Ctrl+o exec xdotool mousedown 2
  bindsym Ctrl+e exec xdotool mousedown 3

  bindsym Ctrl+Alt+a exec xdotool mouseup 1
  bindsym Ctrl+Alt+o exec xdotool mouseup 2
  bindsym Ctrl+Alt+e exec xdotool mouseup 3

  bindsym Shift+t exec xdotool key Page_Up
  bindsym Shift+n exec xdotool key Page_Down

  bindsym Return mode "default"
  bindsym Escape mode "default"
  bindsym $mod+m mode "default"
}
bindsym $mod+m mode "mouse"

# the bar is polybar, started by scripts/monitors.sh
